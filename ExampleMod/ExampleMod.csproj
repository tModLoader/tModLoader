
<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\tModLoader.targets" />

  <PropertyGroup>
    <AssemblyName>ExampleMod</AssemblyName>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup>
    <Version>1.0</Version>
    <DisplayName>Example Mod</DisplayName>
    <Author>TML Team</Author>
    <Homepage>https://tmodloader.net/</Homepage>
    <HideResources>false</HideResources>
    <IncludeSource>true</IncludeSource>
    <BuildIgnore>*.csproj, *.user, obj\*, bin\*, .vs\*, Old\*</BuildIgnore>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Old\**" />
    <EmbeddedResource Remove="Old\**" />
    <None Remove="Old\**" />
  </ItemGroup>

</Project>