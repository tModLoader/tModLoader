+
+	private static void AssignWorldCreationOptionTypes(List<WorldCreationMenuOption> options, int firstModdedType)
+	{
+		int nextType = firstModdedType;
+		for (int i = 0; i < options.Count; i++) {
+			WorldCreationMenuOption option = options[i];
+			if (TryGetVanillaWorldCreationOptionType(option.Id, out int type)) {
+				option.Type = type;
+				continue;
+			}
+
+			option.Type = nextType++;
+		}
+
+		if (firstModdedType == GameModeID.TML)
+			GameModeID.Count = Math.Max(GameModeID.Count, nextType);
+		else if (firstModdedType == WorldEvilID.TML)
+			WorldEvilID.Count = Math.Max(WorldEvilID.Count, nextType);
+	}
+
+	private static bool TryGetVanillaWorldCreationOptionType(string id, out int type)
+	{
+		type = 0;
+		int separatorIndex = id.LastIndexOf(':');
+		return separatorIndex >= 0 && int.TryParse(id.AsSpan(separatorIndex + 1), out type);
+	}
+
+	private static int GetMaxEvilOptionsPerRow(int optionCount)
+	{
+		if (optionCount <= 3)
+			return 3;
+
+		if (optionCount <= 5)
+			return 2;
+
+		return Math.Min(4, (optionCount + 1) / 2);
+	}
+
+	private GroupOptionButton<WorldCreationMenuOption>[] AddWorldCreationOptions(UIElement container, float accumualtedHeight, MouseEvent clickEvent, string tagGroup, float usableWidthPercent, List<WorldCreationMenuOption> options, int spacingPixels, int maxOptionsPerRow, out int rows)
+	{
+		rows = Math.Max(1, (options.Count + maxOptionsPerRow - 1) / maxOptionsPerRow);
+		GroupOptionButton<WorldCreationMenuOption>[] buttons = new GroupOptionButton<WorldCreationMenuOption>[options.Count];
+		for (int i = 0; i < buttons.Length; i++) {
+			int row = i / maxOptionsPerRow;
+			int column = i % maxOptionsPerRow;
+			int rowItemCount = Math.Min(maxOptionsPerRow, buttons.Length - row * maxOptionsPerRow);
+			WorldCreationMenuOption option = options[i];
+			GroupOptionButton<WorldCreationMenuOption> groupOptionButton = new GroupOptionButton<WorldCreationMenuOption>(option, option.Title, option.Description, option.TextColor, option.IconTexturePath, 1f, 1f, 16f);
+			// Split the row's total inter-button spacing across its items so its last button ends exactly at the usable right edge.
+			groupOptionButton.Width = StyleDimension.FromPixelsAndPercent(spacingPixels * (rowItemCount - 1) / (float)rowItemCount, usableWidthPercent / rowItemCount);
+			groupOptionButton.Left = StyleDimension.FromPixelsAndPercent(-spacingPixels * column / (float)rowItemCount, 1f - usableWidthPercent + column * usableWidthPercent / rowItemCount);
+			groupOptionButton.HAlign = 0f;
+			groupOptionButton.Top.Set(accumualtedHeight + row * 44f, 0f);
+			groupOptionButton.OnLeftMouseDown += clickEvent;
+			groupOptionButton.OnMouseOver += ShowOptionDescription;
+			groupOptionButton.OnMouseOut += ClearOptionDescription;
+			groupOptionButton.SetSnapPoint(tagGroup, i);
+			container.Append(groupOptionButton);
+			buttons[i] = groupOptionButton;
+		}
+
+		return buttons;
 	}
 
