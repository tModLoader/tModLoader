+	// Added by TML. Chat command localizations may omit the leading '/', letting a single key serve as both the command and the name it stands for (see EmojiName), instead of needing a second "/{$Name}" key
+	private static bool MatchCommandPrefix(LocalizedText command, string text, out string remainder)
+	{
+		if (!text.StartsWith('/')) {
+			remainder = default;
+			return false;
+		}
+
+		return command.ParseCommandPrefix(text, out remainder) || command.ParseCommandPrefix(text.Substring(1), out remainder);
